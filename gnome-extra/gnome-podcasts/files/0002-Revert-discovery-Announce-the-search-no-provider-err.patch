From 020170b78e9cbeb0354e5f256d2a8c669f435e8c Mon Sep 17 00:00:00 2001
From: Poncho <poncho@spahan.ch>
Date: Fri, 19 Apr 2024 23:12:50 +0200
Subject: [PATCH 2/3] Revert "discovery: Announce the search no provider error
 to screenreaders."

This reverts commit 7fa338961f122b4b00c789ced292a80d17813ee1.
---
 podcasts-gtk/Cargo.toml                    | 2 +-
 podcasts-gtk/src/widgets/discovery_page.rs | 4 ----
 2 files changed, 1 insertion(+), 5 deletions(-)

diff --git a/podcasts-gtk/Cargo.toml b/podcasts-gtk/Cargo.toml
index ba60ebc6..73bb7b54 100644
--- a/podcasts-gtk/Cargo.toml
+++ b/podcasts-gtk/Cargo.toml
@@ -15,7 +15,7 @@ futures-util = "0.3"
 gettext-rs = { version = "0.7", features = ["gettext-system"] }
 gst = { version = "0.22", package = "gstreamer" }
 gst-play = { version = "0.22", package = "gstreamer-play" }
-gtk = { package = "gtk4", version = "0.8", features = ["gnome_44", "v4_14"] }
+gtk = { package = "gtk4", version = "0.8", features = ["gnome_44"] }
 html2text = "0.6"
 html5ever = "0.26"
 humansize = "1"
diff --git a/podcasts-gtk/src/widgets/discovery_page.rs b/podcasts-gtk/src/widgets/discovery_page.rs
index 58b2cb43..cdc49c8b 100644
--- a/podcasts-gtk/src/widgets/discovery_page.rs
+++ b/podcasts-gtk/src/widgets/discovery_page.rs
@@ -57,10 +57,6 @@ impl DiscoveryPagePriv {
                 if let Err(NoSearchPlatformsSelected) = result {
                     this.entry.add_css_class("error");
                     this.no_platforms_selected_label.set_visible(true);
-                    this.no_platforms_selected_label.announce(
-                        &this.no_platforms_selected_label.text(),
-                        gtk::AccessibleAnnouncementPriority::High
-                    );
                 }
                 this.search_button.set_visible(true);
                 this.loading_spinner.set_visible(false);
-- 
